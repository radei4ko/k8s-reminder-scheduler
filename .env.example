# Copy to .env for local docker-compose use: cp .env.example .env
# In Kubernetes these come from a ConfigMap/Secret instead - see k8s/.

DATABASE_URL=mysql+pymysql://reminder_user:change_me@mysql:3306/reminder_scheduler

# Every worker pod needs a unique identity - this is what goes in owner_id on
# a claimed task. Leave empty: it defaults to the container hostname, which
# Docker and Kubernetes already make unique per container.
WORKER_ID=

# How long a worker holds a task before another worker is allowed to consider
# it abandoned and reclaim it. Must comfortably exceed how long a real
# reminder send takes, or a slow-but-alive worker gets its own task stolen.
LEASE_SECONDS=30

# Retry attempts per reminder task before it is marked dead.
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_DELAY_SECONDS=300

# How often a worker polls the database for due work.
POLL_INTERVAL_SECONDS=3
CLAIM_BATCH_SIZE=10

# Failure rate of the notifier stub, 0.0-1.0.
NOTIFIER_FAILURE_RATE=0.3
